---
// Admin Modals Component
---
<!-- Modal: Tambah Cicilan & Riwayat Pembayaran -->
<div class="admin-modal-overlay hidden" id="payment-modal">
  <div class="admin-modal">
    <div class="modal-head">
      <h3 id="modal-room-title">Pembukuan Kamar</h3>
      <button class="modal-close-btn" onclick="closePaymentModal()">&times;</button>
    </div>
    
    <div style="background-color:var(--bg-muted); padding:16px; border-radius:var(--radius-md); margin-bottom:20px; display:flex; justify-content:space-between;">
      <div>
        <span style="font-size:0.8rem; color:var(--text-muted);">Sudah Dibayar</span>
        <div style="font-weight:700; color:var(--primary); font-size:1.1rem;" id="modal-summary-paid">Rp 0</div>
      </div>
      <div style="text-align:right;">
        <span style="font-size:0.8rem; color:var(--text-muted);">Sisa Tagihan</span>
        <div style="font-weight:700; color:#f59e0b; font-size:1.1rem;" id="modal-summary-rem">Rp 0</div>
      </div>
    </div>

    <form id="payment-form">
      <div class="form-group" style="margin-bottom:12px;">
        <label for="pay-amount">Jumlah Pembayaran / Cicilan (Rp)</label>
        <input type="number" id="pay-amount" placeholder="Contoh: 200000" min="1000" required>
      </div>
      <div class="form-group" style="margin-bottom:12px;">
        <label for="pay-date">Tanggal Bayar</label>
        <input type="date" id="pay-date" required>
      </div>
      <div class="form-group" style="margin-bottom:16px;">
        <label for="pay-note">Keterangan / Catatan</label>
        <input type="text" id="pay-note" placeholder="Contoh: Cicilan 1 (Transfer BCA) / Bayar Tunai">
      </div>
      <div style="margin-bottom:20px; display:flex; align-items:center; gap:8px;">
        <input type="checkbox" id="pay-send-wa" checked style="width:auto;">
        <label for="pay-send-wa" style="font-weight:normal; font-size:0.9rem; cursor:pointer;">Langsung kirim bukti kwitansi ke WhatsApp penghuni</label>
      </div>
      <button type="submit" class="btn btn-primary btn-block">+ Simpan Pembayaran</button>
    </form>

    <div class="ledger-history">
      <h4>Riwayat Pembayaran Bulan Ini</h4>
      <div class="ledger-list" id="modal-ledger-list"></div>
    </div>
  </div>
</div>

<!-- Modal: Pengaturan Data Kamar & Penghuni -->
<div class="admin-modal-overlay hidden" id="edit-room-modal">
  <div class="admin-modal">
    <div class="modal-head">
      <h3 id="edit-room-title">Pengaturan Kamar</h3>
      <button class="modal-close-btn" onclick="closeEditRoomModal()">&times;</button>
    </div>
    <form id="edit-room-form">
      <input type="hidden" id="edit-room-id">
      <div class="form-group" style="margin-bottom:12px;">
        <label for="edit-tenant-name">Nama Penghuni</label>
        <input type="text" id="edit-tenant-name" placeholder="Nama lengkap penghuni">
      </div>
      <div class="form-group" style="margin-bottom:12px;">
        <label for="edit-tenant-phone">Nomor WhatsApp Penghuni</label>
        <input type="tel" id="edit-tenant-phone" placeholder="Contoh: 081234567890">
      </div>
      <div class="form-group" style="margin-bottom:12px;">
        <label for="edit-monthly-rate">Tarif Sewa Bulanan (Rp)</label>
        <input type="number" id="edit-monthly-rate" step="50000" required>
      </div>
      <div class="form-group" style="margin-bottom:16px;">
        <label for="edit-due-day">Tanggal Jatuh Tempo Setiap Bulan</label>
        <input type="number" id="edit-due-day" min="1" max="31" required>
      </div>
      <div style="margin-bottom:20px; display:flex; align-items:center; gap:8px;">
        <input type="checkbox" id="edit-occupied" style="width:auto;">
        <label for="edit-occupied" style="font-weight:normal; font-size:0.9rem; cursor:pointer;">Kamar sedang terisi / berpenghuni</label>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Simpan Perubahan</button>
    </form>
  </div>
</div>
