---
// Admin Header Component with Professional SVG Icon
---
<header class="admin-header">
  <div class="admin-header-container">
    <div class="admin-title-area">
      <img src="/assets/logo-symbol.png?v=2.0.0" alt="Kos Fitrah" style="height:28px;">
      <h1>Pembukuan Kos Fitrah</h1>
      <span class="admin-badge">9 Kamar</span>
    </div>
    <div class="admin-controls">
      <input type="month" id="filter-period" class="month-picker" aria-label="Pilih Periode Bulan">
      <button id="admin-logout-btn" class="btn btn-secondary btn-sm" title="Kunci Dashboard" style="display:inline-flex; align-items:center; gap:6px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
        Kunci
      </button>
    </div>
  </div>
</header>
