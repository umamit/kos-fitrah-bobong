---
// Admin Header Component
---
<header class="admin-header">
  <div class="admin-header-container">
    <div class="admin-title-area">
      <img src="/assets/logo-symbol.png?v=2.0.0" alt="Kos Fitrah" style="height:28px;">
      <h1>Pembukuan Kos Fitrah</h1>
      <span class="admin-badge">9 Kamar</span>
    </div>
    <div class="admin-controls">
      <input type="month" id="filter-period" class="month-picker" aria-label="Pilih Periode Bulan">
      <button id="admin-logout-btn" class="btn btn-secondary btn-sm" title="Kunci Dashboard">🔒 Kunci</button>
    </div>
  </div>
</header>
